{
    "collections": {
        "users": {
            "description": "Stores user account information, profile, XP system, and settings.",
            "schema": {
                "_id": "ObjectId",
                "name": "String (required)",
                "email": "String (required, unique, indexed)",
                "password": "String (required, hashed with bcrypt)",
                "isVerified": "Boolean (default: false)",
                "verificationCode": "String (6-digit code for email verification)",
                "verificationCodeExpires": "Date (10 min expiry)",
                "passwordResetCode": "String (6-digit code for password reset)",
                "passwordResetExpires": "Date (10 min expiry)",
                "avatar_key": "String (S3/MinIO object key)",
                "bio": "String (max 500 chars)",
                "role": "String (enum: 'student' | 'moderator' | 'admin', default: 'student')",
                "interests": "[String]",
                "socialLinks": "[{ name: String, url: String }]",
                "bookmarked_posts": "[ObjectId (ref: 'posts')]",
                "xp": "Number (default: 0)",
                "level": "Number (default: 1, calculated from XP)",
                "stats": {
                    "totalPosts": "Number (default: 0)",
                    "totalComments": "Number (default: 0)",
                    "totalLikesReceived": "Number (default: 0)",
                    "totalLikesGiven": "Number (default: 0)"
                },
                "badges": "[{ badgeId: String, unlockedAt: Date }]",
                "theme": "String (enum: 'light' | 'dark', default: 'light')",
                "completedCourses": "[String (ref: 'courses')]",
                "createdAt": "Date (auto)",
                "updatedAt": "Date (auto)"
            }
        },
        "courses": {
            "description": "Stores available courses. Mostly static data.",
            "schema": {
                "_id": "String (course code, e.g. 'IS-121')",
                "name": "String (required)",
                "cycle": "Number (required, 1-10)"
            }
        },
        "posts": {
            "description": "Posts with embedded comments. Uses aggregation pipeline for author population.",
            "schema": {
                "_id": "ObjectId",
                "title": "String (required, max 200)",
                "content": "String (required, max 10000)",
                "author": "ObjectId (ref: 'users', required, indexed)",
                "course_id": "String (required, indexed)",
                "hashtags": "[String]",
                "attachments": "[{ name: String, size: Number, type: String, object_key: String }]",
                "createdAt": "Date (indexed)",
                "updatedAt": "Date",
                "views": "Number (default: 0)",
                "viewed_by": "[ObjectId (ref: 'users')]",
                "upvoted_by": "[ObjectId (ref: 'users')]",
                "downvoted_by": "[ObjectId (ref: 'users')]",
                "upvote_count": "Number (default: 0)",
                "downvote_count": "Number (default: 0)",
                "comments": "[CommentSchema (embedded)]",
                "timestamps": true
            },
            "comment_schema": {
                "_id": "ObjectId",
                "author": "ObjectId (ref: 'users', required)",
                "content": "String (required)",
                "createdAt": "Date",
                "score": "Number (default: 0)",
                "upvoted_by": "[ObjectId]",
                "downvoted_by": "[ObjectId]",
                "attachments": "[AttachmentSchema]",
                "replies": "[ReplySchema (recursive)]",
                "parentId": "ObjectId (null for root comments)"
            }
        },
        "notifications": {
            "description": "User notifications for votes, comments, mentions.",
            "schema": {
                "_id": "ObjectId",
                "user": "ObjectId (ref: 'users', required)",
                "text": "String (required)",
                "link": "String (route path)",
                "read": "Boolean (default: false)",
                "createdAt": "Date"
            }
        },
        "settings": {
            "description": "Per-user settings for notifications, privacy, display.",
            "schema": {
                "_id": "ObjectId",
                "user": "ObjectId (ref: 'users', required, unique)",
                "notifications": {
                    "email": "Boolean (default: true)",
                    "push": "Boolean (default: true)",
                    "comments": "Boolean (default: true)",
                    "mentions": "Boolean (default: true)",
                    "votes": "Boolean (default: false)"
                },
                "privacy": {
                    "profileVisibility": "String (enum: 'public' | 'students' | 'private', default: 'public')",
                    "showEmail": "Boolean (default: false)",
                    "showStats": "Boolean (default: true)",
                    "allowMessages": "Boolean (default: true)"
                },
                "display": {
                    "postsPerPage": "Number (default: 10)"
                },
                "sound": {
                    "enabled": "Boolean (default: true)",
                    "volume": "Number (default: 50)"
                }
            }
        },
        "reports": {
            "description": "Post reports from users.",
            "schema": {
                "_id": "ObjectId",
                "post": "ObjectId (ref: 'posts', required)",
                "user": "ObjectId (ref: 'users', required)",
                "reason": "String (required)",
                "createdAt": "Date"
            }
        }
    }
}