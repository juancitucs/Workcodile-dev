    "test:integration": "jest src/__tests__/integration --forceExit --detectOpenHandles",
    "test:e2e": "jest src/__tests__/e2e --forceExit --detectOpenHandles",
    "test:smoke": "jest src/__tests__/smoke --forceExit --detectOpenHandles",
    "test:regression": "jest src/__tests__/regression --forceExit --detectOpenHandles",
    "test:snapshot": "jest src/__tests__/snapshot --forceExit --detectOpenHandles",
    "test:mutation": "jest src/__tests__/mutation --forceExit --detectOpenHandles",
    "test:contract": "jest src/__tests__/contract --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "aws-sdk": "^2.1620.0",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "form-data": "^4.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
